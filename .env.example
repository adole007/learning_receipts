# Neon Postgres (pooled connection string is fine)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Claude API
ANTHROPIC_API_KEY="sk-ant-..."
# Model used for structuring, generation and grading
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Optional cheaper model for the independent entailment verifier (defaults to ANTHROPIC_MODEL)
ANTHROPIC_VERIFIER_MODEL="claude-haiku-4-5-20251001"

# Fallback when ANTHROPIC_API_KEY is empty: NVIDIA's OpenAI-compatible API (build.nvidia.com)
NVIDIA_API_KEY="nvapi-..."
# Must support tool calling
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"
# Optional separate verifier model (defaults to NVIDIA_MODEL)
NVIDIA_VERIFIER_MODEL=""

# Public base URL (used in portfolio links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
